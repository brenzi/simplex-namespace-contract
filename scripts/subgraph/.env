# Copy to scripts/subgraph/.env and fill in.

# Mainnet RPC for graph-node to follow. Any provider works; the subgraph
# only needs read-only eth_getBlockBy*, eth_getLogs, eth_call, trace_*.
# Examples:
#   - your Reth on the host (Linux/macOS):
#       SUBGRAPH_RPC_URL=http://host.docker.internal:8545
#   - Alchemy:
#       SUBGRAPH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<your-key>
#   - DRPC public:
#       SUBGRAPH_RPC_URL=https://lb.drpc.org/ogrpc?network=ethereum&dkey=<your-key>
SUBGRAPH_RPC_URL=http://192.168.1.58:8545

# Optional: override Postgres password (default = let-me-in; only listening
# on loopback so it's harmless on a local dev box).
# POSTGRES_PASSWORD=let-me-in

   "height": 30,
   "text": "ROLE: registration gateway, TLD policy,\n           on-chain index (#20)",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ROLE: registration gateway, TLD policy,\n           on-chain index (#20)",

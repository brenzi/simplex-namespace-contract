   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": -73,
   "y": 372,
   "width": 287.09999999999997,
   "height": 110,
   "text": "STORES:\n- commitments (commit-reveal)\n- tldNode / tldSuffix / minCharLength\n- reservedNames, NFT-gate config\n- price-oracle ref (+ freeze flag)\n- labelOf[labelhash] -> label   (#20)\n- allLabels[]  (every 2LD ever)   (#20)\n- childrenOf[parentNode] -> labelhashes (#20)",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "STORES:\n- commitments (commit-reveal)\n- tldNode / tldSuffix / minCharLength\n- reservedNames, NFT-gate config\n- price-oracle ref (+ freeze flag)\n- labelOf[labelhash] -> label   (#20)\n- allLabels[]  (every 2LD ever)   (#20)\n- childrenOf[parentNode] -> labelhashes (#20)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el-18",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",

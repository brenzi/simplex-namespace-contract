      "x": 1218,
      "y": 1398,
      "width": 338.14,
      "height": 96.25,
      "text": "label        = a single name part, e.g. \"alice\"\nlabelhash    = keccak256(label)\nnode/namehash= keccak256(parentNode, labelhash)\ntldNode      = namehash(\"testing\")\nparentNode   = node of the parent (2LD for a subname)\ntokenId      = labelhash of the 2LD (ERC-721 id)\ncommitment   = hash(label, owner, secret, ...)",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "label        = a single name part, e.g. \"alice\"\nlabelhash    = keccak256(label)\nnode/namehash= keccak256(parentNode, labelhash)\ntldNode      = namehash(\"testing\")\nparentNode   = node of the parent (2LD for a subname)\ntokenId      = labelhash of the 2LD (ERC-721 id)\ncommitment   = hash(label, owner, secret, ...)",
      "autoResize": true,
      "lineHeight": 1.25
    },

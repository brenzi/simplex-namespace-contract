      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STORES (key -> value):\n- commitments[bytes32 commitment] -> uint ts\n- reservedNames[bytes32 labelhash] -> bool\n- tldNode / tldSuffix / minCharLength\n- NFT-gate config; priceOracle ref (+ freeze)",
      "autoResize": true,
      "lineHeight": 1.25
    },

   "lineHeight": 1.25
  },
  {
   "id": "el-17",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-controller"
   ],
   "frameId": null,
   "seed": 1140889848,
   "version": 1,
   "versionNonce": 2117231532,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": -73,
   "y": 372,
   "width": 287.09999999999997,
   "height": 110,
   "text": "STORES:\n- commitments (commit-reveal)\n- tldNode / tldSuffix / minCharLength\n- reservedNames, NFT-gate config\n- price-oracle ref (+ freeze flag)\n- labelOf[labelhash] -> label   (#20)\n- allLabels[]  (every 2LD ever)   (#20)\n- childrenOf[parentNode] -> labelhashes (#20)",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "STORES:\n- commitments (commit-reveal)\n- tldNode / tldSuffix / minCharLength\n- reservedNames, NFT-gate config\n- price-oracle ref (+ freeze flag)\n- labelOf[labelhash] -> label   (#20)\n- allLabels[]  (every 2LD ever)   (#20)\n- childrenOf[parentNode] -> labelhashes (#20)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el-18",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-controller"
   ],
   "frameId": null,
   "seed": 1629673910,
   "version": 1,
   "versionNonce": 525730816,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": -73,
   "y": 512,
   "width": 293.47999999999996,
   "height": 165,
   "text": "EXPOSES:\n- commit / register / renew  (payable)\n- rentPrice / available / valid\n- registerReserved / addReservedNames\n- createSubname  (atomic create + index,\n  owner FORCED to parent owner; one-time\n  registry setApprovalForAll needed)\n- submitLabel / submitSubname  (permissionless\n  backfill, hash + owner verified)\n- getLabels / getChildren  (paginated views)\n- admin: setPriceOracle/freeze,\n  setMinCharLength, disableNftGate",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "EXPOSES:\n- commit / register / renew  (payable)\n- rentPrice / available / valid\n- registerReserved / addReservedNames\n- createSubname  (atomic create + index,\n  owner FORCED to parent owner; one-time\n  registry setApprovalForAll needed)\n- submitLabel / submitSubname  (permissionless\n  backfill, hash + owner verified)\n- getLabels / getChildren  (paginated views)\n- admin: setPriceOracle/freeze,\n  setMinCharLength, disableNftGate",
   "autoResize": true,
   "lineHeight": 1.25
  },

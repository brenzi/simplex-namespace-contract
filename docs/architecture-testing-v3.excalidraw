      "x": 473,
      "y": 53,
      "width": 299.85999999999996,
      "height": 55,
      "text": "STORES (key -> value):\n- labelOf[bytes32 labelhash] -> subname label\n- childrenOf[bytes32 parentNode] -> labelhash[]\n- childIndexed[bytes32 node] -> bool (dedup)",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STORES (key -> value):\n- labelOf[bytes32 labelhash] -> subname label\n- childrenOf[bytes32 parentNode] -> labelhash[]\n- childIndexed[bytes32 node] -> bool (dedup)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el-30",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

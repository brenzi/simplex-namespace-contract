   "type": "text",
   "x": 473,
   "y": 291,
   "width": 284.2,
   "height": 37.5,
   "text": "IMMUTABLE: the operator-grant target can only\never create caller-owned subnodes. If redeployed,\nrebuild the index by re-creating subnames.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",

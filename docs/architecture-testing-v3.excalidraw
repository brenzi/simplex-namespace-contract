   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 473,
   "y": 131,
   "width": 350.9,
   "height": 110,
   "text": "EXPOSES:\n- createSubname(parentNode, label)\n  (atomic; owner FORCED to parent owner;\n   needs registry.setApprovalForAll(this))\n- deleteSubname(parentNode, label)  (owner-only)\n- purge(parentNode, labelhashes[])  (permissionless GC)\n- getChildren(parentNode, start, count)\n- childrenLength(parentNode)",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "EXPOSES:\n- createSubname(parentNode, label)\n  (atomic; owner FORCED to parent owner;\n   needs registry.setApprovalForAll(this))\n- deleteSubname(parentNode, label)  (owner-only)\n- purge(parentNode, labelhashes[])  (permissionless GC)\n- getChildren(parentNode, start, count)\n- childrenLength(parentNode)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el-31",
   "angle": 0,

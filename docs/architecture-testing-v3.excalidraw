   "y": 395,
   "width": 287.09999999999997,
   "height": 68.75,
   "text": "STORES (key -> value):\n- commitments[bytes32 commitment] -> uint ts\n- reservedNames[bytes32 labelhash] -> bool\n- tldNode / tldSuffix / minCharLength\n- NFT-gate config; priceOracle ref (+ freeze)",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "STORES (key -> value):\n- commitments[bytes32 commitment] -> uint ts\n- reservedNames[bytes32 labelhash] -> bool\n- tldNode / tldSuffix / minCharLength\n- NFT-gate config; priceOracle ref (+ freeze)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
